{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Array indexing yields T | undefined. The engine and the screens index constantly,
    // so biome's noNonNullAssertion is off: the `!` is the deliberate acknowledgement
    // this flag exists to force, not a smell.
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "test", "worker", "vite.config.ts"]
}
