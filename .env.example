# Copy this file to .env for local development. .env is ignored by Git.
# Configure production values in Cloudflare Pages > Settings > Environment variables.
# VITE_ values become public browser code; never put private keys or secrets here.

VITE_GOODDOLLAR_ENV=production

# Optional social login. Uncomment both values and use the network for your client ID.
# Allow your local and deployed site origins in the Web3Auth project dashboard.
# VITE_WEB3AUTH_CLIENT_ID=your-public-client-id
# VITE_WEB3AUTH_NETWORK=sapphire_devnet

# Optional deployed Celo contracts; see contracts/DEPLOY.md and docs/MAINNET_DEPLOY.md.
# Leave unused entries commented out, rather than setting them to empty strings.
# VITE_SNARL_GIFTS=0xYourDeployedGiftsAddress
# VITE_SNARL_NAMES=0xYourDeployedNamesAddress
# VITE_SNARL_BOARD=0xYourDeployedBoardAddress
# VITE_SNARL_WEEKLY=0xYourDeployedWeeklyAddress
# VITE_SNARL_TRAILS=0xYourDeployedTrailsAddress
