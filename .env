# Deployed contract addresses, on Celo mainnet.
#
# Public information — these are on the chain and in the block explorer. No keys, no
# secrets, ever: Vite inlines everything named VITE_* into the bundle it ships to the
# browser. Anything private belongs in .env.local, which git ignores.
#
# Each one is optional. With a variable unset the game behaves exactly as it did before
# that contract existed, which is also how to turn a feature off in a hurry.

# G$ behind a gift link. Ownerless.
VITE_SNARL_GIFTS=0x06Cf5deeB69D331DCdf37897BDc5337ba663Ed2B

# One name per verified person. Ownerless.
VITE_SNARL_NAMES=0x608e899633239d46055838BB267Bbf13b067975b

# Untangles per person, and the roster they are proved against.
VITE_SNARL_BOARD=0xa0478a7fAE7917D42B0D99E0f3a307cfe9C01342

# The Great Untangle's pool, and each person's run of weeks.
VITE_SNARL_WEEKLY=0x4B901584C3AdD752a1bc25415D2a1997A7701612

# GoodDollar has no testnet: "staging" is a different set of contracts on Celo mainnet.
# VITE_GOODDOLLAR_ENV=production

# Signing in with Google or an email instead of installing a wallet, via Web3Auth.
#
# Unset, the option is not offered and not one byte of it is downloaded — the code after
# the "no client id" check is unreachable, so the bundler drops the whole SDK. Set, it
# costs about 900 KB gzipped, loaded only when somebody actually takes that door. For an
# audience on cheap phones and metered data that is a real decision, not a flag.
#
# Celo has to be enabled for the project in Web3Auth's own dashboard; chains are
# configured there rather than here.
# VITE_WEB3AUTH_CLIENT_ID=
# VITE_WEB3AUTH_NETWORK=sapphire_mainnet
